# Copy to ~/.hermes/.env and fill locally. Never commit the filled file.
# Provider: optional when using OAuth subscription (`hermes setup --portal` or `hermes auth add`).
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
# TELEGRAM_CRON_THREAD_ID=

# Discord Developer Portal (enable Message Content Intent)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
# DISCORD_ALLOWED_ROLES=
# DISCORD_HOME_CHANNEL=
DISCORD_REQUIRE_MENTION=true
